
# MyPick production environment example.
# Do NOT put the real SECRET_KEY in GitHub or public ZIPs.
# On the server, set these values through systemd Environment= lines
# or an EnvironmentFile readable only by the service user.

MYPICK_ENV=production
MYPICK_DB_PATH=/var/www/mypick/kbo_fantasy.db
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_GENERATED_ON_THE_SERVER
